// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// Catalog Items (moulding / mat / glazing / mounting)
// D-1: data-driven, taggable by tier
// ─────────────────────────────────────────
enum CatalogItemType {
  MOULDING
  MAT
  GLAZING
  MOUNT
}

enum Tier {
  BUDGET
  MID
  PREMIUM
}

model CatalogItem {
  id                  String          @id @default(uuid())
  name                String
  type                CatalogItemType
  imageUrl            String
  priceKES            Decimal         @db.Decimal(12, 2)
  tier                Tier
  archivalDescription String          // D-7: concrete specs, never generic copy
  createdAt           DateTime        @default(now())

  mouldingConfigs     Configuration[] @relation("ConfigMoulding")
  matConfigs          Configuration[] @relation("ConfigMat")
  glazingConfigs      Configuration[] @relation("ConfigGlazing")
  mountConfigs        Configuration[] @relation("ConfigMount")
}

// ─────────────────────────────────────────
// Configuration — one client's selected combination
// D-10: mountId nullable — no default mount
// ─────────────────────────────────────────
model Configuration {
  id         String      @id @default(uuid())
  fileUrl    String
  sessionId  String
  moulding   CatalogItem @relation("ConfigMoulding", fields: [mouldingId], references: [id])
  mouldingId String
  mat        CatalogItem @relation("ConfigMat", fields: [matId], references: [id])
  matId      String
  glazing    CatalogItem @relation("ConfigGlazing", fields: [glazingId], references: [id])
  glazingId  String
  mount      CatalogItem? @relation("ConfigMount", fields: [mountId], references: [id])
  mountId    String?     // Nullable — D-10 enforced
  createdAt  DateTime    @default(now())

  orders     Order[]
  mockups    Mockup[]   // Slice 2: back-relation
}

// ─────────────────────────────────────────
// Order — one Configuration, priced + committed
// Price snapshot taken at add-to-cart time
// ─────────────────────────────────────────
model Order {
  id               String        @id @default(uuid())
  configuration    Configuration @relation(fields: [configurationId], references: [id])
  configurationId  String
  priceSnapshotKES Decimal       @db.Decimal(12, 2)
  cart             Cart          @relation(fields: [cartId], references: [id])
  cartId           String
  createdAt        DateTime      @default(now())
}

// ─────────────────────────────────────────
// Cart — one or more Orders, exactly one path
// D-15: path set once, immutable after creation
// A-13: DIRECT skips commission/discount/approval
// ─────────────────────────────────────────
enum CartPath {
  DIRECT
  REFERRAL
  RESALE
}

model Cart {
  id             String       @id @default(uuid())
  path           CartPath     // D-15: set on creation, never mutated
  photographer   Photographer? @relation(fields: [photographerId], references: [id])
  photographerId String?
  referralCode   String?
  // M-Pesa payment tracking
  mpesaCheckoutId   String?
  paymentStatus     String?   @default("PENDING") // PENDING | CONFIRMED | REJECTED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders            Order[]
  approval          Approval?
  commissionEntries CommissionLedgerEntry[]
  resaleDiscount    ResaleDiscount?
}

// ─────────────────────────────────────────
// Photographer — self-declared, no verification gate
// resolved C-3
// ─────────────────────────────────────────
model Photographer {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  email              String?   @unique
  isPhotographer     Boolean   @default(true)
  sessionToken       String?
  otpCode            String?
  otpExpiresAt       DateTime?
  resaleDiscountRate Decimal   @default(13.00) @db.Decimal(5, 2) // A-7: 13% default
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  referralLinks      ReferralLink[]
  commissionEntries  CommissionLedgerEntry[]
  carts              Cart[]
}

// ─────────────────────────────────────────
// ReferralLink — generated by Photographer
// A-6: attributes a Cart to photographer as referral
// ─────────────────────────────────────────
model ReferralLink {
  id             String       @id @default(uuid())
  photographer   Photographer @relation(fields: [photographerId], references: [id])
  photographerId String
  code           String       @unique @default(uuid())
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────
// CommissionLedgerEntry — on completed referral Cart
// A-10, D-9, D-13: KES, visible only on owning photographer's dashboard
// ─────────────────────────────────────────
model CommissionLedgerEntry {
  id             String       @id @default(uuid())
  photographer   Photographer @relation(fields: [photographerId], references: [id])
  photographerId String
  cart           Cart         @relation(fields: [cartId], references: [id])
  cartId         String       @unique
  amountKES      Decimal      @db.Decimal(12, 2) // D-13: KES
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────
// ResaleDiscount — applied to resale Cart at checkout
// A-7: 13% default, studio-overridable per Photographer
// ─────────────────────────────────────────
model ResaleDiscount {
  id                  String   @id @default(uuid())
  cart                Cart     @relation(fields: [cartId], references: [id])
  cartId              String   @unique
  discountRatePercent Decimal  @db.Decimal(5, 2)
  discountAmountKES   Decimal  @db.Decimal(12, 2) // D-13: KES
  createdAt           DateTime @default(now())
}

// ─────────────────────────────────────────
// StudioConfig — single record; read by every page
// A-11, D-11: swappable config, never hardcoded
// commissionRatePercent: 10% default (user-confirmed)
// ─────────────────────────────────────────
model StudioConfig {
  id                    Int     @id @default(1)
  name                  String  @default("Hollow & Hale") // placeholder only
  logoUrl               String  @default("/logo-placeholder.svg")
  commissionRatePercent Decimal @default(10.00) @db.Decimal(5, 2)
  brandAccentColor      String  @default("#c8a96e")
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────
// Approval — status on Photographer-originated Carts
// resolved former C-6: applies to both REFERRAL and RESALE
// ─────────────────────────────────────────
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id        String         @id @default(uuid())
  cart      Cart           @relation(fields: [cartId], references: [id])
  cartId    String         @unique
  status    ApprovalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ─────────────────────────────────────────
// ConversionEvent — configuration_started / configuration_completed
// E-3: dual success metric
// ─────────────────────────────────────────
enum ConversionEventType {
  CONFIGURATION_STARTED
  CONFIGURATION_COMPLETED
}

model ConversionEvent {
  id        String              @id @default(uuid())
  type      ConversionEventType
  sessionId String
  createdAt DateTime            @default(now())
}

// ─────────────────────────────────────────
// Scene — curated, studio-approved room/wall background
// A-9, D-14: static curated library; swappable via admin (A-11 pattern)
// ─────────────────────────────────────────
model Scene {
  id          String    @id @default(uuid())
  name        String
  description String?
  imageUrl    String    // absolute URL or /api/blobs/scenes/... path
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  mockups     Mockup[]
}

// ─────────────────────────────────────────
// Mockup — Configuration + Scene + Placement
// A-9, D-17: before/after, adjustable placement
// Placement is embedded (x/y/scale as fractions of scene dimensions)
// ─────────────────────────────────────────
model Mockup {
  id              String        @id @default(uuid())
  configuration   Configuration @relation(fields: [configurationId], references: [id])
  configurationId String
  scene           Scene         @relation(fields: [sceneId], references: [id])
  sceneId         String

  // Placement — D-17: move/scale/perspective within scene canvas
  placementX       Float   @default(0.5)  // 0–1, normalised cx within scene
  placementY       Float   @default(0.5)  // 0–1, normalised cy within scene
  placementScale   Float   @default(0.4)  // piece width as fraction of scene width
  placementRotateY Float   @default(0.0)  // Y-axis wall perspective tilt in degrees (-45 to +45)
  placementRotateX Float   @default(0.0)  // X-axis wall perspective tilt in degrees (-30 to +30)

  mockupImageUrl  String?  // cached composite; null until first render
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
