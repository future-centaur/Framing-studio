{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/api/blobs/[...path]",
      "regex": "^/api/blobs/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/blobs/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/design-link/[id]",
      "regex": "^/api/design\\-link/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/design\\-link/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/mockup/[id]",
      "regex": "^/api/mockup/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/mockup/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/mockup/[id]/placement",
      "regex": "^/api/mockup/([^/]+?)/placement(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/mockup/(?<nxtPid>[^/]+?)/placement(?:/)?$"
    },
    {
      "page": "/api/mockup/[id]/start-order",
      "regex": "^/api/mockup/([^/]+?)/start\\-order(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/mockup/(?<nxtPid>[^/]+?)/start\\-order(?:/)?$"
    },
    {
      "page": "/api/orders/[cartId]/approve",
      "regex": "^/api/orders/([^/]+?)/approve(?:/)?$",
      "routeKeys": {
        "nxtPcartId": "nxtPcartId"
      },
      "namedRegex": "^/api/orders/(?<nxtPcartId>[^/]+?)/approve(?:/)?$"
    },
    {
      "page": "/api/referral/[code]",
      "regex": "^/api/referral/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/api/referral/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/r/[code]",
      "regex": "^/r/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/r/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/visualize/[configurationId]",
      "regex": "^/visualize/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPconfigurationId": "nxtPconfigurationId"
      },
      "namedRegex": "^/visualize/(?<nxtPconfigurationId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/cart",
      "regex": "^/cart(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cart(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/configure",
      "regex": "^/configure(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/configure(?:/)?$"
    },
    {
      "page": "/photographer/dashboard",
      "regex": "^/photographer/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/photographer/dashboard(?:/)?$"
    },
    {
      "page": "/photographer/login",
      "regex": "^/photographer/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/photographer/login(?:/)?$"
    },
    {
      "page": "/photographer/resale",
      "regex": "^/photographer/resale(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/photographer/resale(?:/)?$"
    },
    {
      "page": "/photographer/signup",
      "regex": "^/photographer/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/photographer/signup(?:/)?$"
    },
    {
      "page": "/studio-config",
      "regex": "^/studio\\-config(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio\\-config(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}